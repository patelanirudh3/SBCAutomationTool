+// isSubscribeFinalError reports whether an event code represents a final SIP
+// error response that permanently rejects a SUBSCRIBE (4xx/5xx/6xx, excluding
+// 407 and 401 which are auth challenges handled separately).
+func isSubscribeFinalError(code string) bool {
+	if len(code) != 3 {
+		return false
+	}
+	switch code[0] {
+	case '4', '5', '6':
+		return code != "407" && code != "401"
+	}
